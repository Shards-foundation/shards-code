{
  "name": "@mavis/agent-tools",
  "version": "0.2.1",
  "description": "Platform-owned runtime tool definitions and helpers for Mavis hosts.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./desktop": {
      "types": "./src/desktop/index.ts",
      "import": "./dist/desktop/index.js"
    },
    "./desktop/subagent-roles": {
      "types": "./src/desktop/subagent-roles.ts",
      "import": "./dist/desktop/subagent-roles.js"
    },
    "./desktop/managed-routing": {
      "types": "./src/desktop/managed-routing.ts",
      "import": "./dist/desktop/managed-routing.js"
    },
    "./read-contract": {
      "types": "./src/shared/read-contract.ts",
      "import": "./dist/shared/read-contract.js"
    },
    "./plugin-hooks": {
      "types": "./src/plugin-hooks/index.ts",
      "import": "./dist/plugin-hooks/index.js"
    },
    "./matrix": {
      "types": "./dist/cloud/matrix-tools/index.d.ts",
      "import": "./dist/cloud/matrix-tools/index.js"
    }
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "workspace:*",
    "@earendil-works/pi-coding-agent": "workspace:*",
    "@mavis/agent-core": "workspace:^",
    "@mavis/plugin-hooks": "workspace:^",
    "@mavis/background-task": "workspace:^",
    "@mavis/context-manager": "workspace:^",
    "@mavis/protocol": "workspace:^",
    "@mavis/shared": "workspace:^",
    "@mavis/system-reminder": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.0",
    "@vscode/ripgrep": "1.18.0",
    "diff": "8.0.4",
    "jszip": "^3.10.1",
    "js-yaml": "^4",
    "minimatch": "10.2.6",
    "shell-quote": "^1.8.1",
    "tar": "^7.5.22",
    "undici": "^8.10.2",
    "unpdf": "^1.6.2",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4",
    "@types/node": "^20",
    "@types/shell-quote": "^1.7.5",
    "typescript": "^7",
    "vitest": "^2",
    "@mavis/protocol": "workspace:*"
  },
  "private": true,
  "license": "MIT"
}
